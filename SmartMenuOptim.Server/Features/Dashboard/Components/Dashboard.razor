@*
    Dashboard page - Restaurant overview, order metrics, and sales performance.
    Markup only; logic lives in Dashboard.razor.cs, styles in Dashboard.razor.css.
    Premium restyle shares the landing design language (slate + amber, Fraunces + Inter).
*@

@page "/dashboard"
@using SmartMenuOptim.Application.Common
@using SmartMenuOptim.Application.Dtos
@using SmartMenuOptim.Application.Features.Restaurants.DTOs
@using SmartMenuOptim.Application.Features.Orders.DTOs
@using SmartMenuOptim.Server.Components.Shared

<PageTitle>Dashboard - SmartMenuOptimizer</PageTitle>

<div class="smo-dash" @ref="Root">

    @* ── Page header ─────────────────────────────────────────────── *@
    <header class="smo-dash-head" data-anim style="--i:0">
        <div>
            <h1 class="smo-dash-title">Dashboard</h1>
            <p class="smo-dash-sub">Your restaurants, orders, and menu performance at a glance.</p>
        </div>
        <a href="/insights" class="smo-btn smo-btn-primary">
            <i class="bi bi-lightbulb"></i>AI Insights
        </a>
    </header>

    @* ── KPI hero band (the one bold moment) ─────────────────────── *@
    <section class="smo-hero" data-anim style="--i:1">
        @if (!_ready)
        {
            <div class="smo-hero-loading">
                <span class="smo-hero-dot"></span>
                <span class="smo-hero-dot"></span>
                <span class="smo-hero-dot"></span>
            </div>
        }
        else
        {
            <div class="smo-kpi smo-kpi--accent">
                <span class="smo-kpi-label">Order Revenue</span>
                <span class="smo-kpi-value" data-count="@Inv(OrderTotalRevenue)" data-decimals="0" data-prefix="$" data-group="true">$0</span>
                <span class="smo-kpi-foot">@ActiveOrderCount active now</span>
            </div>
            <div class="smo-kpi">
                <span class="smo-kpi-label">Total Orders</span>
                <span class="smo-kpi-value" data-count="@(allOrders?.Count ?? 0)" data-group="true">0</span>
                <span class="smo-kpi-foot">@OrderAverageValue.ToString("C") avg value</span>
            </div>
            <div class="smo-kpi">
                <span class="smo-kpi-label">Open Restaurants</span>
                <span class="smo-kpi-value" data-count="@(restaurants?.Count(r => r.IsAcceptingOrders) ?? 0)" data-suffix="@("/" + (restaurants?.Count ?? 0))">0</span>
                <span class="smo-kpi-foot">accepting orders</span>
            </div>
            <div class="smo-kpi">
                <span class="smo-kpi-label">Dishes Sold</span>
                <span class="smo-kpi-value" data-count="@SummaryDishesSold" data-group="true">0</span>
                <span class="smo-kpi-foot">@SummaryTotalSales.ToString("C") in sales</span>
            </div>
        }
    </section>

    @* ═══ Restaurant overview ════════════════════════════════════ *@
    <section class="smo-panel" data-anim style="--i:2">
        <div class="smo-panel-head">
            <span class="smo-panel-icon"><i class="bi bi-shop"></i></span>
            <h2 class="smo-panel-title">Restaurant Overview</h2>
        </div>

        <LoadingSpinner IsLoading="restaurantsLoading" Message="Loading restaurants..." ContainerClass="py-4" />

        @if (!restaurantsLoading && restaurants is not null && restaurants.Any())
        {
            <div class="smo-stats smo-stats--3">
                <div class="smo-stat">
                    <span class="smo-stat-num">@restaurants.Count</span>
                    <span class="smo-stat-label">Total Restaurants</span>
                </div>
                <div class="smo-stat smo-stat--good">
                    <span class="smo-stat-num">@restaurants.Count(r => r.IsAcceptingOrders)</span>
                    <span class="smo-stat-label">Open for Orders</span>
                </div>
                <div class="smo-stat smo-stat--muted">
                    <span class="smo-stat-num">@restaurants.Count(r => !r.IsAcceptingOrders)</span>
                    <span class="smo-stat-label">Closed</span>
                </div>
            </div>

            <div class="smo-rgrid">
                @foreach (var restaurant in restaurants)
                {
                    var todayHours = restaurant.BusinessHours?.FirstOrDefault(h => h.DayOfWeek == DateTime.Now.DayOfWeek);

                    <article class="smo-rcard">
                        <div class="smo-rcard-top">
                            <div class="smo-rcard-id">
                                <h3 class="smo-rcard-name">@restaurant.Name</h3>
                                <span class="smo-rcard-loc">
                                    <i class="bi bi-geo-alt"></i>
                                    @(restaurant.Address is not null ? $"{restaurant.Address.City}, {restaurant.Address.State}" : "No address")
                                </span>
                            </div>
                            <span class="smo-pill @(restaurant.IsAcceptingOrders ? "smo-pill--open" : "smo-pill--closed")">
                                @(restaurant.IsAcceptingOrders ? "Open" : "Closed")
                            </span>
                        </div>
                        <div class="smo-rcard-hours">
                            <i class="bi bi-clock"></i>
                            <span class="smo-muted">Today</span>
                            @if (todayHours is not null && !todayHours.IsClosed)
                            {
                                <span class="smo-hours-val">
                                    @todayHours.OpenTime.ToString(@"hh\:mm") – @todayHours.CloseTime.ToString(@"hh\:mm")
                                </span>
                            }
                            else
                            {
                                <span class="smo-hours-closed">Closed today</span>
                            }
                        </div>
                        <div class="smo-rcard-actions">
                            <button class="smo-btn smo-btn-ghost" @onclick="() => NavigateToRestaurant(restaurant.Id)">
                                <i class="bi bi-eye"></i>Details
                            </button>
                            <button class="smo-btn smo-btn-ghost" @onclick="NavigateToInsights">
                                <i class="bi bi-lightbulb"></i>Insights
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
        else if (!restaurantsLoading)
        {
            <div class="smo-empty">
                <i class="bi bi-shop"></i>
                <p>No restaurants yet.</p>
                <a href="/restaurants" class="smo-btn smo-btn-primary">
                    <i class="bi bi-plus-lg"></i>Add your first restaurant
                </a>
            </div>
        }
    </section>

    @* ═══ Order metrics ══════════════════════════════════════════ *@
    <section class="smo-panel" data-anim style="--i:3">
        <div class="smo-panel-head">
            <span class="smo-panel-icon"><i class="bi bi-cart-check"></i></span>
            <h2 class="smo-panel-title">Order Metrics</h2>
        </div>

        <LoadingSpinner IsLoading="ordersLoading" Message="Loading order metrics..." ContainerClass="py-4" />

        @if (!ordersLoading && allOrders is not null && allOrders.Any())
        {
            <div class="smo-stats smo-stats--4">
                <div class="smo-stat">
                    <span class="smo-stat-num">@allOrders.Count</span>
                    <span class="smo-stat-label">Total Orders</span>
                </div>
                <div class="smo-stat smo-stat--good">
                    <span class="smo-stat-num">@OrderTotalRevenue.ToString("C")</span>
                    <span class="smo-stat-label">Total Revenue</span>
                </div>
                <div class="smo-stat smo-stat--accent">
                    <span class="smo-stat-num">@OrderAverageValue.ToString("C")</span>
                    <span class="smo-stat-label">Avg Order Value</span>
                </div>
                <div class="smo-stat">
                    <span class="smo-stat-num">@ActiveOrderCount</span>
                    <span class="smo-stat-label">Active Orders</span>
                </div>
            </div>

            <h3 class="smo-subhead"><i class="bi bi-pie-chart"></i>Status Breakdown</h3>
            <div class="smo-chips">
                @foreach (var statusGroup in allOrders.GroupBy(o => o.StatusName).OrderByDescending(g => g.Count()))
                {
                    var colorCode = statusGroup.First().StatusColorCode;
                    var dotStyle = !string.IsNullOrWhiteSpace(colorCode) ? $"background-color:{colorCode};" : "";
                    <span class="smo-chip">
                        <span class="smo-chip-dot" style="@dotStyle"></span>
                        @statusGroup.Key
                        <span class="smo-chip-count">@statusGroup.Count()</span>
                    </span>
                }
            </div>

            <h3 class="smo-subhead"><i class="bi bi-shop"></i>Orders by Restaurant</h3>
            <div class="smo-table-wrap">
                <table class="smo-table">
                    <thead>
                        <tr>
                            <th>Restaurant</th>
                            <th class="num">Orders</th>
                            <th class="num">Revenue</th>
                            <th class="num">Avg Value</th>
                            <th class="num">Items</th>
                            <th class="ctr">Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in allOrders.GroupBy(o => o.RestaurantId).OrderByDescending(g => g.Sum(o => o.TotalAmount)))
                        {
                            var restaurantName = restaurants?.FirstOrDefault(r => r.Id == group.Key)?.Name ?? $"Restaurant #{group.Key}";
                            var revenue = group.Sum(o => o.TotalAmount);
                            var avgValue = group.Average(o => o.TotalAmount);
                            var totalItems = group.Sum(o => o.ItemCount);
                            var activeCount = group.Count(o => !o.IsTerminal);

                            <tr>
                                <td>
                                    <a href="/orders?restaurantId=@group.Key" class="smo-tlink">
                                        <i class="bi bi-shop"></i>@restaurantName
                                    </a>
                                </td>
                                <td class="num">@group.Count()</td>
                                <td class="num smo-num-strong">@revenue.ToString("C")</td>
                                <td class="num">@avgValue.ToString("C")</td>
                                <td class="num">@totalItems</td>
                                <td class="ctr">
                                    @if (activeCount > 0)
                                    {
                                        <span class="smo-badge-active">@activeCount</span>
                                    }
                                    else
                                    {
                                        <span class="smo-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (!ordersLoading)
        {
            <div class="smo-empty">
                <i class="bi bi-cart"></i>
                <p>No orders yet.</p>
                <a href="/orders/new" class="smo-btn smo-btn-primary">
                    <i class="bi bi-plus-lg"></i>Place your first order
                </a>
            </div>
        }
    </section>

    @* ═══ Sales performance ══════════════════════════════════════ *@
    <section class="smo-panel" data-anim style="--i:4">
        <div class="smo-panel-head">
            <span class="smo-panel-icon"><i class="bi bi-graph-up"></i></span>
            <h2 class="smo-panel-title">Sales Performance</h2>
            <button class="smo-btn smo-btn-ghost smo-panel-action" @onclick="ToggleGuide">
                <i class="bi bi-question-circle"></i>@(_showGuide ? "Hide guide" : "How to use")
            </button>
        </div>

        @if (_showGuide)
        {
            <div class="smo-guide">
                <strong>Reading this dashboard</strong>
                <ul>
                    <li><b>Quantity sold</b> — how many times each dish has been ordered.</li>
                    <li><b>Sale dates</b> — when dishes sell best, so you can spot trends.</li>
                    <li><b>Categories</b> — group dishes to compare performance.</li>
                    <li><b>Total sales</b> — revenue per restaurant and category.</li>
                    <li><b>Rating</b> — average customer rating per dish and category.</li>
                </ul>
                <span class="smo-guide-foot">Use these to tune your menu, adjust inventory, and plan promotions.</span>
            </div>
        }

        <div class="smo-stats smo-stats--3">
            <div class="smo-stat">
                <span class="smo-stat-num">@SummarySaleRecords</span>
                <span class="smo-stat-label">Total Items</span>
            </div>
            <div class="smo-stat smo-stat--good">
                <span class="smo-stat-num">@SummaryDishesSold</span>
                <span class="smo-stat-label">Dishes Sold</span>
            </div>
            <div class="smo-stat smo-stat--accent">
                <span class="smo-stat-num">@SummaryTotalSales.ToString("C")</span>
                <span class="smo-stat-label">Total Sales</span>
            </div>
        </div>

        <LoadingSpinner IsLoading="isloading" Message="Loading sales data..." ContainerClass="py-4" />

        @if (!isloading && saleRecords is not null && !saleRecords.Any())
        {
            <div class="smo-empty">
                <i class="bi bi-inbox"></i>
                <p>No sales records yet.</p>
            </div>
        }
        else if (!isloading && saleRecords is not null)
        {
            @foreach (var restaurantGroup in saleRecords.GroupBy(r => r.RestaurantName))
            {
                var restaurantTotalSales = restaurantGroup.Sum(r => r.DishPrice * r.QuantitySold);
                var restaurantAvgRating = restaurantGroup.Any(r => r.Rating > 0)
                    ? restaurantGroup.Where(r => r.Rating > 0).Average(r => r.Rating)
                    : 0;
                bool isExpanded = expandedRestaurant == restaurantGroup.Key;

                <div class="smo-sales-group">
                    <button class="smo-group @(isExpanded ? "is-open" : "")" @onclick="() => ToggleRestaurant(restaurantGroup.Key)">
                        <span class="smo-group-main">
                            <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") smo-group-chev"></i>
                            <i class="bi bi-shop"></i>
                            <span class="smo-group-name">@restaurantGroup.Key</span>
                        </span>
                        <span class="smo-group-meta">
                            <span class="smo-tag">@restaurantGroup.Count() records</span>
                            <span class="smo-tag smo-tag--sales">@restaurantTotalSales.ToString("C")</span>
                            <span class="smo-tag smo-tag--rating" title="Average rating">
                                <span class="smo-stars">@RenderStars(restaurantAvgRating)</span>
                                @restaurantAvgRating.ToString("0.0")
                            </span>
                        </span>
                    </button>

                    @if (isExpanded)
                    {
                        foreach (var categoryGroup in restaurantGroup.GroupBy(r => r.Category))
                        {
                            var categoryTotalSales = categoryGroup.Sum(r => r.DishPrice * r.QuantitySold);
                            var avgRating = categoryGroup.Any(r => r.Rating > 0)
                                ? categoryGroup.Where(r => r.Rating > 0).Average(r => r.Rating)
                                : 0;

                            <div class="smo-cat">
                                <div class="smo-cat-head">
                                    <span class="smo-cat-name">
                                        <i class="bi bi-tag"></i>@categoryGroup.Key
                                    </span>
                                    <span class="smo-cat-meta">
                                        <span class="smo-tag smo-tag--sales">@categoryTotalSales.ToString("C")</span>
                                        <span class="smo-tag smo-tag--rating" title="Average rating">
                                            <span class="smo-stars">@RenderStars(avgRating)</span>
                                            @avgRating.ToString("0.0")
                                        </span>
                                    </span>
                                </div>
                                <div class="smo-table-wrap">
                                    <table class="smo-table">
                                        <thead>
                                            <tr>
                                                <th>Dish</th>
                                                <th class="num">Qty Sold</th>
                                                <th class="num">Price</th>
                                                <th class="ctr">Sale Date</th>
                                                <th class="ctr">Rating</th>
                                                <th class="num">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var record in categoryGroup)
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="#" class="smo-dish-link" @onclick="() => OnDishClicked(record.DishName)" @onclick:preventDefault>
                                                            @record.DishName
                                                        </a>
                                                    </td>
                                                    <td class="num">@record.QuantitySold</td>
                                                    <td class="num">@record.DishPrice.ToString("C")</td>
                                                    <td class="ctr">@record.SaleDate.ToString("MMM dd, yyyy")</td>
                                                    <td class="ctr">
                                                        @if (record.Rating > 0)
                                                        {
                                                            <span class="smo-stars" title="Rating: @record.Rating/5">@RenderStars(record.Rating)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="smo-muted">N/A</span>
                                                        }
                                                    </td>
                                                    <td class="num smo-num-strong">@((record.DishPrice * record.QuantitySold).ToString("C"))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        }
    </section>
</div>
