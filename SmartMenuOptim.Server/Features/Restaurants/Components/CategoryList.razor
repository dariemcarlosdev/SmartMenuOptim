@page "/restaurants/{RestaurantId:int}/categories"

<PageTitle>Categories - SmartMenuOptimizer</PageTitle>

<div class="container mt-4">
    @* Breadcrumb *@
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/restaurants">Restaurants</a></li>
            <li class="breadcrumb-item"><a href="/restaurants/@RestaurantId">Restaurant</a></li>
            <li class="breadcrumb-item active">Categories</li>
        </ol>
    </nav>

    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-tags me-2"></i>Categories
            </h2>
            <p class="text-muted mb-0">Organize your menu items into categories</p>
        </div>
        <button class="btn btn-primary" @onclick="ShowAddForm">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </button>
    </div>

    @* Error Alert *@
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    @* Success Alert *@
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    @* Loading State *@
    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading categories...</span>
            </div>
        </div>
    }
    @* Categories List *@
    else
    {
        <div class="row">
            @* Categories Table/Cards *@
            <div class="col-lg-8">
                @if (_categories is null || !_categories.Any())
                {
                    <div class="card shadow-sm">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-tags display-1 text-muted mb-3"></i>
                            <h4>No categories yet</h4>
                            <p class="text-muted mb-3">Create categories to organize your menu items</p>
                            <button class="btn btn-primary" @onclick="ShowAddForm">
                                <i class="bi bi-plus-lg me-1"></i> Create First Category
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm">
                        @* Reorder hint *@
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-grip-vertical me-1"></i>
                                Drag rows to reorder categories
                            </small>
                            @if (_reordering)
                            {
                                <span class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">Saving order...</span>
                                </span>
                            }
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;"></th>
                                        <th style="width: 60px;">Order</th>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th style="width: 80px;">Status</th>
                                        <th style="width: 140px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var category in _categories.OrderBy(c => c.DisplayOrder))
                                    {
                                        <tr class="@GetRowClass(category)"
                                            draggable="true"
                                            @ondragstart="() => HandleDragStart(category)"
                                            @ondragover="HandleDragOver"
                                            @ondragover:preventDefault
                                            @ondrop="() => HandleDropAsync(category)"
                                            @ondragend="HandleDragEnd"
                                            style="cursor: grab;">
                                            <td class="text-center text-muted">
                                                <i class="bi bi-grip-vertical"></i>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@category.DisplayOrder</span>
                                            </td>
                                            <td class="fw-semibold">@category.Name</td>
                                            <td class="text-muted small">
                                                @(string.IsNullOrWhiteSpace(category.Description) 
                                                    ? "—" 
                                                    : TruncateText(category.Description, 50))
                                            </td>
                                            <td>
                                                <span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">
                                                    @(category.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" 
                                                            @onclick="() => EditCategory(category)"
                                                            @onclick:stopPropagation="true"
                                                            title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" 
                                                            @onclick="() => ConfirmDelete(category)"
                                                            @onclick:stopPropagation="true"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            @* Add/Edit Form Panel *@
            <div class="col-lg-4">
                @if (_showForm)
                {
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <i class="bi @(_editingCategory is null ? "bi-plus-circle" : "bi-pencil") me-2"></i>
                            @(_editingCategory is null ? "Add Category" : "Edit Category")
                        </div>
                        <div class="card-body">
                            <EditForm Model="@_formModel" OnValidSubmit="SaveCategoryAsync">
                                <DataAnnotationsValidator />

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="_formModel.Name" 
                                               placeholder="e.g., Appetizers, Main Course" />
                                    <ValidationMessage For="() => _formModel.Name" class="text-danger small" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Description</label>
                                    <InputTextArea class="form-control" @bind-Value="_formModel.Description" 
                                                   rows="2" placeholder="Brief description of this category" />
                                </div>

                                <div class="row mb-3">
                                    <div class="col-6">
                                        <label class="form-label fw-semibold">Display Order</label>
                                        <InputNumber class="form-control" @bind-Value="_formModel.DisplayOrder" />
                                        <small class="text-muted">Or drag rows to reorder</small>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fw-semibold">Status</label>
                                        <div class="form-check form-switch mt-2">
                                            <InputCheckbox class="form-check-input" @bind-Value="_formModel.IsActive" />
                                            <label class="form-check-label">Active</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                                        @if (_saving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        @(_editingCategory is null ? "Add" : "Update")
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">
                                        Cancel
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm bg-light">
                        <div class="card-body text-center py-4">
                            <i class="bi bi-info-circle display-4 text-muted mb-3"></i>
                            <h5>Category Tips</h5>
                            <ul class="text-start small text-muted mb-0">
                                <li>Use clear, descriptive names</li>
                                <li><strong>Drag rows</strong> to quickly reorder categories</li>
                                <li>Deactivate categories to hide from menus</li>
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Delete Confirmation Modal *@
    @if (_showDeleteModal && _categoryToDelete is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                            Confirm Delete
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong>@_categoryToDelete.Name</strong>?</p>
                        <p class="text-muted small mb-0">Dishes in this category will need to be reassigned.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteCategoryAsync" disabled="@_deleting">
                            @if (_deleting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
