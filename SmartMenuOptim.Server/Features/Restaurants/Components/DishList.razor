@page "/restaurants/{RestaurantId:int}/dishes"
@page "/restaurants/{RestaurantId:int}/menus/{MenuId:int}/dishes"

<PageTitle>Dishes - SmartMenuOptimizer</PageTitle>

<div class="container-fluid mt-4">
    @* Breadcrumb *@
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/restaurants">Restaurants</a></li>
            <li class="breadcrumb-item"><a href="/restaurants/@RestaurantId">Restaurant</a></li>
            @if (MenuId.HasValue)
            {
                <li class="breadcrumb-item"><a href="/restaurants/@RestaurantId/menus">Menus</a></li>
                <li class="breadcrumb-item active">Menu Dishes</li>
            }
            else
            {
                <li class="breadcrumb-item active">All Dishes</li>
            }
        </ol>
    </nav>

    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-cup-straw me-2"></i>@(MenuId.HasValue ? "Menu Dishes" : "All Dishes")
            </h2>
            <p class="text-muted mb-0">
                @(MenuId.HasValue 
                    ? "Manage dishes assigned to this menu" 
                    : "Manage all dishes for this restaurant")
            </p>
        </div>
        <div class="btn-group">
            @if (MenuId.HasValue)
            {
                <button class="btn btn-outline-primary" @onclick="ShowAddDishModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Existing Dish
                </button>
            }
            <button class="btn btn-primary" @onclick="CreateNew">
                <i class="bi bi-plus-lg me-1"></i> Create New Dish
            </button>
        </div>
    </div>

    @* Filter by Category *@
    @if (_categories?.Any() == true && !MenuId.HasValue)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body py-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small">Filter by category:</span>
                    <button class="btn btn-sm @(_selectedCategoryId is null ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => FilterByCategory(null)">
                        All
                    </button>
                    @foreach (var category in _categories)
                    {
                        <button class="btn btn-sm @(_selectedCategoryId == category.Id ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => FilterByCategory(category.Id)">
                            @category.Name
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @* Error Alert *@
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    @* Loading State *@
    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading dishes...</span>
            </div>
        </div>
    }
    @* Empty State *@
    else if (_filteredDishes is null || !_filteredDishes.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-cup-straw display-1 text-muted mb-3"></i>
                <h4>No dishes found</h4>
                <p class="text-muted mb-3">
                    @(MenuId.HasValue 
                        ? "Add dishes to this menu from your restaurant's dish catalog" 
                        : "Create dishes to add to your menus")
                </p>
                <button class="btn btn-primary" @onclick="CreateNew">
                    <i class="bi bi-plus-lg me-1"></i> Create New Dish
                </button>
            </div>
        </div>
    }
    @* Dish Table *@
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Dish Name</th>
                            <th>Category</th>
                            <th class="text-end">Price</th>
                            <th class="text-center">Status</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dish in _filteredDishes)
                        {
                            <tr class="@(!dish.IsActive ? "table-secondary" : "")">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                            <i class="bi bi-cup-straw text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@dish.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(dish.Description))
                                            {
                                                <small class="text-muted">@TruncateText(dish.Description, 40)</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">@(dish.CategoryName ?? "Uncategorized")</span>
                                </td>
                                <td class="text-end fw-semibold">
                                    @dish.Price.ToString("C")
                                </td>
                                <td class="text-center">
                                    @if (dish.IsVegetarian)
                                    {
                                        <span class="badge bg-success me-1" title="Vegetarian">
                                            <i class="bi bi-leaf"></i>
                                        </span>
                                    }
                                    @if (dish.IsSpicy)
                                    {
                                        <span class="badge bg-danger me-1" title="Spicy">
                                            <i class="bi bi-fire"></i>
                                        </span>
                                    }
                                    <span class="badge @(dish.IsActive ? "bg-success" : "bg-secondary")">
                                        @(dish.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" 
                                                @onclick="() => Edit(dish.Id)"
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (MenuId.HasValue)
                                        {
                                            <button class="btn btn-outline-warning" 
                                                    @onclick="() => RemoveFromMenu(dish)"
                                                    title="Remove from menu">
                                                <i class="bi bi-dash-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-danger" 
                                                    @onclick="() => ConfirmDelete(dish)"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3 text-muted small">
            Showing @_filteredDishes.Count dish(es)
        </div>
    }

    @* Delete Confirmation Modal *@
    @if (_showDeleteModal && _dishToDelete is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                            Confirm Delete
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong>@_dishToDelete.Name</strong>?</p>
                        <p class="text-muted small mb-0">This dish will be removed from all menus.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="DeleteDishAsync" disabled="@_deleting">
                            @if (_deleting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Add to Menu Modal (for menu context) *@
    @if (_showAddToMenuModal && MenuId.HasValue)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-plus-circle me-2"></i>
                            Add Dish to Menu
                        </h5>
                        <button type="button" class="btn-close" @onclick="() => _showAddToMenuModal = false"></button>
                    </div>
                    <div class="modal-body">
                        @if (_availableDishes?.Any() == true)
                        {
                            <div class="list-group">
                                @foreach (var dish in _availableDishes)
                                {
                                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                            @onclick="() => AddToMenuAsync(dish)">
                                        <div>
                                            <strong>@dish.Name</strong>
                                            <small class="text-muted ms-2">@(dish.CategoryName ?? "Uncategorized")</small>
                                        </div>
                                        <span class="badge bg-primary">@dish.Price.ToString("C")</span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">No available dishes to add.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
