@page "/submit-review"
@using SmartMenuOptim.Application.Dtos
@using SmartMenuOptim.Server.Features.Reviews.Models
@using SmartMenuOptim.Application.Common
@using System.ComponentModel.DataAnnotations
@inject IReviewClientService ReviewService
@inject IAIClientService AIService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            @if (isSubmitted)
            {
                <div class="card shadow-sm text-center">
                    <div class="card-body">
                        <h4 class="card-title">🎉 Thank You!</h4>
                        <p>Your review has been submitted successfully.</p>
                        <button class="btn btn-primary" @onclick="SubmitAnother">Submit Another Review</button>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">✍️ Share Your Feedback</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="@reviewModel" OnValidSubmit="HandleValidSubmit" FormName="SubmitReview">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="customerName" class="form-label">Your Name</label>
                                <InputText id="customerName" class="form-control" @bind-Value="reviewModel.CustomerName" />
                                <ValidationMessage For="@(() => reviewModel.CustomerName)" />
                            </div>

                            <div class="mb-3">
                                <label for="dishName" class="form-label">Dish Name</label>
                                <InputText id="dishName" class="form-control" @bind-Value="reviewModel.DishName" />
                                <ValidationMessage For="@(() => reviewModel.DishName)" />
                            </div>

                            <div class="mb-3">
                                <label for="rating" class="form-label">Rating (1-5)</label>
                                <InputNumber id="rating" class="form-control" @bind-Value="reviewModel.Rating" min="1" max="5" />
                                <ValidationMessage For="@(() => reviewModel.Rating)" />
                            </div>

                            <div class="mb-3">
                                <label for="comment" class="form-label">Comment</label>
                                <InputTextArea id="comment" class="form-control" @bind-Value="reviewModel.Comment" rows="4" />
                                <ValidationMessage For="@(() => reviewModel.Comment)" />
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span> Submitting...</span>
                                    }
                                    else
                                    {
                                        <span>Submit Review</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ReviewFormModel reviewModel = new();
    private bool isSubmitting = false;
    private bool isSubmitted = false;

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;

        var reviewDto = new ReviewDTO
        {
            CustomerName = reviewModel.CustomerName,
            DishName = reviewModel.DishName,
            Rating = reviewModel.Rating,
            Comment = reviewModel.Comment,
            DateCreated = DateTime.UtcNow
        };

        try
        {           
            await ReviewService.AddReviewAsync(reviewDto);
            isSubmitted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting review: {ex.Message}");
            // Optionally, display an error message to the user
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void SubmitAnother()
    {
        reviewModel = new();
        isSubmitted = false;
    }

}