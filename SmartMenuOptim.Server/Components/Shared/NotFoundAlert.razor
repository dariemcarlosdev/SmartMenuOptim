@*
    File: NotFoundAlert.razor
    Reusable "not found" display component
    Version: 1.0
    .NET Target: .NET 9

    Purpose: Provides a consistent "resource not found" display with navigation.
*@

<div class="alert alert-warning" role="alert">
    <i class="bi bi-question-circle me-2"></i>
    @Message
    @if (!string.IsNullOrWhiteSpace(BackLinkUrl))
    {
        <a href="@BackLinkUrl" class="alert-link">@BackLinkText</a>
    }
</div>
