@*
    File: StatItem.razor
    Reusable statistic display component
    Version: 1.0
    .NET Target: .NET 9

    Purpose: Provides a consistent key-value stat display.
    Used in Quick Stats cards and similar contexts.
*@

<div class="d-flex justify-content-between align-items-center @(ShowBorder ? "mb-3 pb-3 border-bottom" : "")">
    <span class="text-muted">@Label</span>
    @if (UseBadge)
    {
        <span class="badge @BadgeClass fs-6">@Value</span>
    }
    else
    {
        <span class="fw-semibold @ValueClass">@Value</span>
    }
</div>
