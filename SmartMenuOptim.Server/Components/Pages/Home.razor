@page "/"
@using SmartMenuOptim.Server.Components.Layout
@layout LandingLayout

<PageTitle>Home</PageTitle>

<div class="text-light">
    <div class="d-flex justify-content-center align-items-center text-center text-light">
        <section>
            <h1 class="display-4 fw-bold">Smart Menu Optimizer</h1>
            <p class="lead fs-3 fw-semibold mb-3">Unleash AI Insights to Transform Every Dish</p>
            <p class="fs-5 mb-4">Spot trends, delight customers, and boost profits with data-driven decisions.</p>
            @* <a href="/dashboard" class="btn btn_content btn-lg mb-4">Go to Dashboard</a> *@
            <a href="/dashboard" class="btn btn-primary btn-lg mb-4 fw-semibold" style="background-color: rgb(30, 52, 68); border-color: rgb(30, 52, 68); font-size: 1.35rem; padding: 0.9rem 2.2rem;">
                Start Free Trial &amp; Register
            </a>
        </section>
    </div>
</div>

<div class="container py-5">
    <h2 class="h3 fw-bold mb-4 text-center text-white">Why Smart Menu Optimizer?</h2>
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-3">
            <div class="feature-tile brand-section-bg  text-center p-3 h-100">
                <div class="feature-icon mb-3">
                    <span class="bi bi-bar-chart-line-fill" style="font-size:2.5rem;color:#232e3c;"></span>
                </div>
                <h5 class="fw-bold mb-2 text-dark">Boost Profitability</h5>
                <p class="text-secondary mb-0">
                    Identify top-performing dishes and underperformers to maximize your revenue. Use performance analytics to spotlight your best sellers, refine your menu, and make strategic changes that drive profitability and business growth.
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-tile  brand-section-bg  text-center p-3 h-100">
                <div class="feature-icon mb-3">
                    <span class="bi bi-emoji-smile-fill" style="font-size:2.5rem;color:#232e3c;"></span>
                </div>
                <h5 class="fw-bold mb-2 text-dark">Enhance Satisfaction</h5>
                <p class="text-secondary mb-0">
                    Analyze feedback and ratings to improve your menu and delight guests. Discover what your customers love, address areas for improvement, and create memorable dining experiences that keep them coming back.
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-tile  brand-section-bg  text-center p-3 h-100">
                <div class="feature-icon mb-3">
                    <span class="bi bi-graph-up-arrow" style="font-size:2.5rem;color:#232e3c;"></span>
                </div>
                <h5 class="fw-bold mb-2 text-dark">Data-Driven Decisions</h5>
                <p class="text-secondary mb-0">
                    Get actionable insights for inventory, promotions, and menu adjustments. Make smarter decisions with real-time analytics, optimize stock levels, and tailor your offerings to boost sales and customer satisfaction.
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-tile  brand-section-bg  text-center p-3 h-100">
                <div class="feature-icon mb-3">
                    <span class="bi bi-clock-history" style="font-size:2.5rem;color:#232e3c;"></span>
                </div>
                <h5 class="fw-bold mb-2 text-dark">Real-Time Monitoring</h5>
                <p class="text-secondary mb-0">
                    Track sales, trends, and customer feedback as they happen. Instantly spot shifts in demand, respond to guest preferences, and make timely adjustments to keep your menu competitive and your customers satisfied.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Additional Smart Menu Brand Section -->
<div class="container my-5">
    <div class="brand-section-bg">
        <div class="row flex-column flex-lg-row align-items-center">
            <!-- Left: Text Content -->
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h2 class="fw-bold mb-4" style="font-size:2.3rem; color:#232e3c;">Build, protect and grow your restaurant brand</h2>
                <div class="mb-4">
                    <h5 class="fw-bold mb-2" style="color:#232e3c;">Build your brand</h5>
                    <p class="fs-5 text-secondary mb-0">
                        Stand out in the market by optimizing your menu with data-driven insights. Highlight your best dishes and create a memorable dining experience that sets your restaurant apart.
                    </p>
                </div>
                <div class="mb-4">
                    <h5 class="fw-bold mb-2" style="color:#232e3c;">Boost your online presence</h5>
                    <p class="fs-5 text-secondary mb-0">
                        Showcase your top-rated dishes and customer reviews online. Connect your menu to social media and food platforms to attract new guests and keep loyal customers engaged.
                    </p>
                </div>
                <div>
                    <h5 class="fw-bold mb-2" style="color:#232e3c;">With a platform you can trust</h5>
                    <p class="fs-5 text-secondary mb-0">
                        Smart Menu Optimizer is trusted by restaurant owners for its reliability, security, and actionable insights. Our platform helps you make confident decisions to grow your business.
                    </p>
                </div>
            </div>
            <!-- Right: Illustration -->
            <div class="col-lg-6 d-flex justify-content-center align-items-start">
                <div class="brand-illustration bg-white rounded shadow p-4 illustration-mobile-spacing" style="min-width:500px; max-width:600px;">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning rounded-3 d-flex align-items-center justify-content-center" style="width:64px;height:64px;">
                            <span class="bi bi-clipboard-data" style="font-size:2.2rem;color:#232e3c;"></span>
                        </div>
                        <div class="ms-3 flex-grow-1">
                            <div class="bg-primary rounded-pill px-4 py-2 text-white fw-bold" style="font-size:1.1rem;">
                                <span class="bi bi-search me-2"></span>Menu Insights
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="bg-light rounded border mb-2 p-2" style="height:40px;">
                            <span class="bi bi-star-fill text-warning me-2"></span>
                            <span class="fw-semibold text-secondary">Top Dish: Truffle Pasta</span>
                        </div>
                        <div class="bg-light rounded border mb-2 p-2" style="height:40px;">
                            <span class="bi bi-graph-up-arrow text-primary me-2"></span>
                            <span class="fw-semibold text-secondary">Sales Trend: +15%</span>
                        </div>
                        <div class="bg-light rounded border p-2" style="height:40px;">
                            <span class="bi bi-people-fill text-info me-2"></span>
                            <span class="fw-semibold text-secondary">Customer Reviews: 4.8/5</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

