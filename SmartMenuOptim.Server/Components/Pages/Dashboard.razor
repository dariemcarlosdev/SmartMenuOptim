@page "/dashboard"
@using SmartMenuOptim.Shared.Data
@using SmartMenuOptim.Shared.Data.Entities
@inject NavigationManager NavigationManager
@inject ISaleRecordService SaleRecordService

<div class="container mt-4">
    <div class="text-center mb-4">
        <h2>📊 Sales Dashboard</h2>
        <p class="text-muted">Track sales performance across your dishes in real time.</p>
    </div>
    @if (isloading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
            <span class="ms-2 align-self-center">Loading Dashboard page...</span>
        </div>
    }
    @if (saleRecords == null)
    {
        <div class="alert alert-info text-center">🔄 Loading sales data...</div>
    }
    else if (!saleRecords.Any())
    {
        <div class="alert alert-warning text-center">📭 No sales records available yet.</div>
    }
    else
    {
        <div class="mb-3 text-center">
            <h5>Total Records: <span class="badge bg-secondary">@saleRecords.Count</span></h5>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Dish</th>
                        <th class="text-end">Quantity Sold</th>
                        <th class="text-center">Sale Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in saleRecords)
                    {
                        <tr>
                            <td>@record.DishName</td>
                            <td class="text-end">@record.QuantitySold</td>
                            <td class="text-center">@record.SaleDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<SaleRecord> saleRecords;
    private bool isloading = true;

    protected override async Task OnInitializedAsync()
    {
        saleRecords = await SaleRecordService.GetSaleRecordsAsync();
        isloading = false;
    }
}
