@* 
    Example usage and implementation of SummaryCard and RestaurantDashboardCard components.
    See BlazorComponentBestPractices.md for more details.
*@

@page "/dashboard"
@using SmartMenuOptim.Application.Common
@using SmartMenuOptim.Application.Dtos
@inject NavigationManager NavigationManager
@inject ISaleRecordService SaleRecordService


<div class="container mt-4">
    <div class="text-center mb-4">
        <h2>📊 Sales Dashboard</h2>
        <p class="text-muted">Track sales performance across your dishes in real time.</p>
    </div>

    <div class="alert alert-info mb-4" role="alert">
        <strong>How to Use the Sales Dashboard:</strong><br />
        This dashboard helps you monitor and analyze your menu's performance in real time.
        <ul class="mb-1 mt-2">
            <li>
                <b>Quantity Sold:</b> See how many times each dish has been ordered. High numbers indicate popular items, while low numbers may signal dishes to review or promote.
            </li>
            <li>
                <b>Sale Dates:</b> Track when dishes are selling best. Spot trends, seasonality, or the impact of promotions and events.
            </li>
            <li>
                <b>Categories:</b> Group dishes by category to compare performance within and across menu sections.
            </li>
            <li>
                <b>Total Sales:</b> Shows the total revenue generated by each restaurant and category, helping you identify your top-earning menu sections and overall business performance.
            </li>
            <li>
                <b>Restaurant Average Rating:</b> Displays the average customer rating for all dishes in a restaurant, giving you a quick overview of overall customer satisfaction per restaurant.
            </li>
            <li>
                <b>Rating:</b> See the average customer rating for each dish in the group, or the average rating for each category. Use this to identify top performers and areas for improvement.
            </li>
        </ul>
        <span class="text-primary">
            Use these insights to optimize your menu, adjust inventory, plan promotions, and boost both customer satisfaction and profits.
        </span>
    </div>

    <!-- Dashboard Summary Cards (Bootstrap, Centered, with Margin) -->
    @* 
        Consider refactoring these summary cards into independent Blazor components 
        (e.g., <SummaryCard />) for better reusability, maintainability, and separation of concerns.
    *@
    <div class="row justify-content-center my-4">
        
        <!-- Total Sale Records Card -->
        <div class="col-12 col-md-4 d-flex align-items-stretch mb-4">
            <div class="card shadow-sm w-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center me-3" style="width:48px; height:48px;">
                        <!-- Document Icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h10M7 16h10M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div>
                        <div class="h5 mb-1 text-primary">@SummarySaleRecords.ToString()</div>
                        <div class="fw-semibold">Total Items </div>
                        <div class="text-muted small">Number of dishes transactions recorded</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Total Dishes Sold Card -->
        <div class="col-12 col-md-4 d-flex align-items-stretch mb-4">
            <div class="card shadow-sm w-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-success text-white rounded d-flex align-items-center justify-content-center me-3" style="width:48px; height:48px;">
                        <!-- Plate Icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2" fill="none" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h8" />
                        </svg>
                    </div>
                    <div>
                        <div class="h5 mb-1 text-success">@SummaryDishesSold.ToString()</div>
                        <div class="fw-semibold">Total Dishes Sold</div>
                        <div class="text-muted small">Total number of dishes sold</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!--    -->
        <div class="col-12 col-md-4 d-flex align-items-stretch mb-4">
            <div class="card shadow-sm w-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-warning text-white rounded d-flex align-items-center justify-content-center me-3" style="width:48px; height:48px;">
                        <!-- Money Icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3zm0 0V4m0 16v-4" />
                        </svg>
                    </div>
                    <div>
                        <div class="h5 mb-1 text-warning">@SummaryTotalSales.ToString("C")</div>
                        <div class="fw-semibold">Total Sales</div>
                        <div class="text-muted small">Total revenue generated from sales</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (isloading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
            <span class="ms-2 align-self-center">Loading Dashboard page...</span>
        </div>
    }
    @if (saleRecords == null)
    {
        <div class="alert alert-info text-center">🔄 Loading sales data...</div>
    }
    else if (!saleRecords.Any())
    {
        <div class="alert alert-warning text-center">📭 No sales records available yet.</div>
    }
    else
    {
    @* <div class="mb-6 text-center">
            <h5 class="text-lg font-semibold mb-2">
                Total Sale Records:
                <span class="inline-block bg-gray-200 text-gray-800 rounded px-2 py-1 ml-1">@saleRecords.Count</span>
            </h5>
            @if (expandedRestaurant is not null)
            {
                var expandedGroup = saleRecords.Where(r => r.RestaurantName == expandedRestaurant);
                var expandedCount = expandedGroup.Count();
                var expandedTotalSales = expandedGroup.Sum(r => r.DishPrice * r.QuantitySold);
                <div class="mt-2">
                    <span class="badge bg-light text-dark">
                        <span style="font-size:1.0em;">🍽️</span> @expandedCount Sold
                    </span>
                    <span class="badge bg-success ms-2">
                        Total Sales: @expandedTotalSales.ToString("$0.00")
                    </span>
                </div>
            }
        </div> *@

        @foreach (var restaurantGroup in saleRecords.GroupBy(r => r.RestaurantName))
        {
            var restaurantTotalSales = restaurantGroup.Sum(r => r.DishPrice * r.QuantitySold);
            var restaurantAvgRating = restaurantGroup.Any(r => r.Rating > 0) ? restaurantGroup.Where(r => r.Rating > 0).Average(r => r.Rating) : 0;
            bool isExpanded = expandedRestaurant == restaurantGroup.Key;
            <div class="mb-5">
                <div class="mb-5 dashboard-header-container">
                <h5 class="dashboard-header-dark">
                    <span>
                      @*<span>
                           <button class="btn btn-sm me-2" @onclick="() => ToggleRestaurant(restaurantGroup.Key)" aria-label="Expand/Collapse">
                                    <span>@(isExpanded ? "−" : "+")</span>
                           </button>
                        </span> *@
                            <span>
@*                                 <button class="btn btn-sm btn-circle me-1 d-flex align-items-center justify-content-center"
                                        @onclick="() => ToggleRestaurant(restaurantGroup.Key)"
                                        aria-label="Expand/Collapse">
                                    <span class="fs-4 fw-bold">@(isExpanded ? "−" : "+")</span>
                                </button> *@
                                <button class="btn btn-sm btn-circle me-1" d-flex
                                        @onclick="() => ToggleRestaurant(restaurantGroup.Key)"
                                        aria-label="Expand/Collapse">
                                    <span class="fs-4 fw-bold">@(isExpanded ? "−" : "+")</span>
                                </button>
                            </span>
                        <span>
                            Restaurant: <span class="fw-bold">@restaurantGroup.Key</span>
                        </span>
                        @*  <span class="badge bg-light text-dark">
                                <span style="font-size:1.0em;">🍽️</span> @restaurantGroup.Count() Sold
                            </span>
                            <span class="badge bg-success">
                                Total Sales: @restaurantTotalSales.ToString("$0.00")
                            </span> *@
                        <span class="badge dashboard-badge bg-warning text-dark" title="Average Rating">
                            @for (int i = 0; i < Math.Round(restaurantAvgRating); i++)
                            {
                                <span>★</span>
                            }
                            @for (int i = (int)Math.Round(restaurantAvgRating); i < 5; i++)
                            {
                                <span class="text-secondary">☆</span>
                            }
                            <span class="ms-1">(@restaurantAvgRating.ToString("0")/5)</span>
                        </span>
                    </span>
                </h5>
                </div>
                @if (isExpanded)
                {
                    foreach (var categoryGroup in restaurantGroup.GroupBy(r => r.Category))
                    {
                        var categoryTotalSales = categoryGroup.Sum(r => r.DishPrice * r.QuantitySold);
                        <div class="mb-4 ms-1">
                            <h5 class="bg-light p-2 border rounded">
                                Category: <span class="text-primary">@categoryGroup.Key</span>
                                <span class="badge bg-secondary ms-2">Total Sales: @categoryTotalSales.ToString("$0.00")</span>
                                @{
                                    var avgRating = categoryGroup.Any(r => r.Rating > 0) ? categoryGroup.Where(r => r.Rating > 0).Average(r => r.Rating) : 0;
                                }
                                <span class="badge dashboard-badge bg-warning text-dark ms-2" title="Average Rating">
                                    @for (int i = 0; i < Math.Round(avgRating); i++)
                                    {
                                        <span>★</span>
                                    }
                                    @for (int i = (int)Math.Round(avgRating); i < 5; i++)
                                    {
                                        <span class="text-secondary">☆</span>
                                    }
                                    <span class="ms-1">(@avgRating.ToString("0")/5)</span>
                                </span>
                            </h5>
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Dish</th>
                                            <th class="text-end">Quantity Sold</th>
                                            <th class="text-end">Dish Price</th>
                                            <th class="text-center">Sale Date</th>
                                            <th class="text-center">Avg Rating</th>
                                            <th class="text-end">Total Sales</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in categoryGroup)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="#" class="dish-link" @onclick="() => OnDishClicked(record.DishName)">
                                                        @record.DishName
                                                    </a>
                                                </td>
                                                <td class="text-end">@record.QuantitySold</td>
                                                <td class="text-end">@record.DishPrice.ToString("C")</td>
                                                <td class="text-center">@record.SaleDate.ToString("MMM dd, yyyy")</td>
                                                <td class="text-center">
                                                    @if (record.Rating > 0)
                                                    {
                                                        <span class="text-warning" title="Average Rating">
                                                            @for (int i = 0; i < record.Rating; i++)
                                                            {
                                                                <span>★</span>
                                                            }
                                                            @for (int i = record.Rating; i < 5; i++)
                                                            {
                                                                <span class="text-secondary">☆</span>
                                                            }
                                                        </span>
                                                        <span class="ms-1">(@record.Rating/5)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">N/A</span>
                                                    }
                                                </td>
                                                <td class="text-end">$@(record.DishPrice* record.QuantitySold)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }
</div>

@code {
    // Holds all sale records loaded from the service
    private List<SaleRecordDTO> saleRecords;

    // Indicates if the dashboard is still loading data
    private bool isloading = true;

    // Only one restaurant group can be expanded at a time
    private string? expandedRestaurant = null;

    // Loads sale records when the component is initialized
    protected override async Task OnInitializedAsync()
    {
        saleRecords = await SaleRecordService.GetSaleRecordsAsync();
        isloading = false;
        // Start with all restaurants collapsed
    }

    // Toggles expansion for a single restaurant group
    private void ToggleRestaurant(string restaurantName)
    {
        if (expandedRestaurant == restaurantName)
            expandedRestaurant = null; // Collapse if already expanded
        else
            expandedRestaurant = restaurantName; // Expand only the clicked one
    }

    // Navigates to the reviews page for a specific dish
    private void OnDishClicked(string dishName)
    {
        NavigationManager.NavigateTo($"/reviews?dishname={Uri.EscapeDataString(dishName)}");
    }

    // Returns the total sale records, overall or for the expanded restaurant
    private int SummarySaleRecords => expandedRestaurant is null
        ? saleRecords?.Count ?? 0
        : saleRecords?.Count(r => r.RestaurantName == expandedRestaurant) ?? 0;

    // Returns the total dishes sold, overall or for the expanded restaurant
    private int SummaryDishesSold => expandedRestaurant is null
        ? saleRecords?.Sum(r => r.QuantitySold) ?? 0
        : saleRecords?.Where(r => r.RestaurantName == expandedRestaurant).Sum(r => r.QuantitySold) ?? 0;

    // Returns the total sales amount, overall or for the expanded restaurant
    private decimal SummaryTotalSales => expandedRestaurant is null
        ? saleRecords?.Sum(r => r.DishPrice * r.QuantitySold) ?? 0
        : saleRecords?.Where(r => r.RestaurantName == expandedRestaurant).Sum(r => r.DishPrice * r.QuantitySold) ?? 0;
}