@*
    Dashboard page - Restaurant overview and sales performance.
    Uses shared components (DetailCard, LoadingSpinner, ErrorAlert) for design uniformity.
*@

@page "/dashboard"
@using SmartMenuOptim.Application.Common
@using SmartMenuOptim.Application.Dtos
@using SmartMenuOptim.Application.Features.Restaurants.DTOs
@using SmartMenuOptim.Server.Services.Abstractions
@using SmartMenuOptim.Server.Features.Restaurants.Services
@using SmartMenuOptim.Server.Components.Shared
@inject NavigationManager NavigationManager
@inject ISaleRecordService SaleRecordService
@inject IRestaurantClientService RestaurantClientService

<PageTitle>Dashboard - SmartMenuOptimizer</PageTitle>

<div class="container mt-4">
    @* Page Header *@
    <div class="mb-4">
        <h2><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
        <p class="text-muted">Restaurant overview and sales performance at a glance.</p>
    </div>

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* RESTAURANT OVERVIEW SECTION                                       *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    <DetailCard HeaderTitle="Restaurant Overview" HeaderIcon="bi-shop" HeaderClass="bg-primary text-white">
        <LoadingSpinner IsLoading="restaurantsLoading" Message="Loading restaurants..." ContainerClass="py-3" />

        @if (!restaurantsLoading && restaurants is not null && restaurants.Any())
        {
            @* Summary Stats Row *@
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center p-3 border rounded">
                        <div class="bg-info text-white rounded d-flex align-items-center justify-content-center me-3" style="width:44px; height:44px;">
                            <i class="bi bi-shop fs-5"></i>
                        </div>
                        <div>
                            <div class="h5 mb-0 text-info">@restaurants.Count</div>
                            <div class="text-muted small">Total Restaurants</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center p-3 border rounded">
                        <div class="bg-success text-white rounded d-flex align-items-center justify-content-center me-3" style="width:44px; height:44px;">
                            <i class="bi bi-check-circle fs-5"></i>
                        </div>
                        <div>
                            <div class="h5 mb-0 text-success">@restaurants.Count(r => r.IsAcceptingOrders)</div>
                            <div class="text-muted small">Open for Orders</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center p-3 border rounded">
                        <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center me-3" style="width:44px; height:44px;">
                            <i class="bi bi-pause-circle fs-5"></i>
                        </div>
                        <div>
                            <div class="h5 mb-0 text-secondary">@restaurants.Count(r => !r.IsAcceptingOrders)</div>
                            <div class="text-muted small">Closed</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Restaurant Quick List *@
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var restaurant in restaurants)
                {
                    var todayHours = restaurant.BusinessHours?.FirstOrDefault(h => h.DayOfWeek == DateTime.Now.DayOfWeek);

                    <div class="col">
                        <div class="card h-100 border">
                            <div class="card-body py-2 px-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <h6 class="mb-0">@restaurant.Name</h6>
                                        <small class="text-muted">
                                            @(restaurant.Address is not null ? $"{restaurant.Address.City}, {restaurant.Address.State}" : "No address")
                                        </small>
                                    </div>
                                    <span class="badge @(restaurant.IsAcceptingOrders ? "bg-success" : "bg-secondary")">
                                        @(restaurant.IsAcceptingOrders ? "Open" : "Closed")
                                    </span>
                                </div>
                                <div class="small">
                                    <i class="bi bi-clock me-1 text-muted"></i>
                                    <span class="text-muted">Today:</span>
                                    @if (todayHours is not null && !todayHours.IsClosed)
                                    {
                                        <span class="fw-semibold text-success">
                                            @todayHours.OpenTime.ToString(@"hh\:mm") – @todayHours.CloseTime.ToString(@"hh\:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fst-italic text-secondary">Closed</span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-transparent py-1">
                                <div class="btn-group btn-group-sm w-100">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => NavigateToRestaurant(restaurant.Id)">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </button>
                                    <button class="btn btn-outline-info btn-sm" @onclick="NavigateToInsights">
                                        <i class="bi bi-lightbulb me-1"></i>AI Insights
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!restaurantsLoading)
        {
            <div class="text-center py-4">
                <i class="bi bi-shop display-4 text-muted mb-3 d-block"></i>
                <p class="text-muted mb-2">No restaurants found.</p>
                <a href="/restaurants" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Add your first restaurant
                </a>
            </div>
        }
    </DetailCard>

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* SALES PERFORMANCE SECTION                                         *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    <DetailCard HeaderTitle="Sales Performance" HeaderIcon="bi-graph-up" HeaderClass="bg-success text-white">
        <HeaderActions>
            <button class="btn btn-sm btn-outline-light" @onclick="ToggleGuide">
                <i class="bi bi-question-circle me-1"></i>@(_showGuide ? "Hide Guide" : "How to Use")
            </button>
        </HeaderActions>
        <ChildContent>
            @* Collapsible Usage Guide *@
            @if (_showGuide)
            {
                <div class="alert alert-info mb-4" role="alert">
                    <strong>How to Use the Sales Dashboard:</strong>
                    <ul class="mb-1 mt-2">
                        <li><b>Quantity Sold:</b> See how many times each dish has been ordered.</li>
                        <li><b>Sale Dates:</b> Track when dishes are selling best to spot trends.</li>
                        <li><b>Categories:</b> Group dishes by category to compare performance.</li>
                        <li><b>Total Sales:</b> Revenue generated by each restaurant and category.</li>
                        <li><b>Rating:</b> Average customer rating for each dish and category.</li>
                    </ul>
                    <span class="text-primary small">
                        Use these insights to optimize your menu, adjust inventory, and plan promotions.
                    </span>
                </div>
            }

            @* Summary Stats Row *@
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center p-3 border rounded">
                        <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center me-3" style="width:44px; height:44px;">
                            <i class="bi bi-receipt fs-5"></i>
                        </div>
                        <div>
                            <div class="h5 mb-0 text-primary">@SummarySaleRecords</div>
                            <div class="text-muted small">Total Items</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center p-3 border rounded">
                        <div class="bg-success text-white rounded d-flex align-items-center justify-content-center me-3" style="width:44px; height:44px;">
                            <i class="bi bi-cup-straw fs-5"></i>
                        </div>
                        <div>
                            <div class="h5 mb-0 text-success">@SummaryDishesSold</div>
                            <div class="text-muted small">Total Dishes Sold</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center p-3 border rounded">
                        <div class="bg-warning text-white rounded d-flex align-items-center justify-content-center me-3" style="width:44px; height:44px;">
                            <i class="bi bi-currency-dollar fs-5"></i>
                        </div>
                        <div>
                            <div class="h5 mb-0 text-warning">@SummaryTotalSales.ToString("C")</div>
                            <div class="text-muted small">Total Sales</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Sales Data *@
            <LoadingSpinner IsLoading="isloading" Message="Loading sales data..." ContainerClass="py-3" />

            @if (!isloading && saleRecords is null)
            {
                <div class="text-center py-3 text-muted">
                    <i class="bi bi-arrow-clockwise me-1"></i>Loading sales data...
                </div>
            }
            else if (!isloading && saleRecords is not null && !saleRecords.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
                    <p class="text-muted">No sales records available yet.</p>
                </div>
            }
            else if (!isloading && saleRecords is not null)
            {
                @foreach (var restaurantGroup in saleRecords.GroupBy(r => r.RestaurantName))
                {
                    var restaurantTotalSales = restaurantGroup.Sum(r => r.DishPrice * r.QuantitySold);
                    var restaurantAvgRating = restaurantGroup.Any(r => r.Rating > 0)
                        ? restaurantGroup.Where(r => r.Rating > 0).Average(r => r.Rating)
                        : 0;
                    bool isExpanded = expandedRestaurant == restaurantGroup.Key;

                    <div class="mb-3">
                        @* Restaurant Group Header *@
                        <div class="dashboard-header-dark" @onclick="() => ToggleRestaurant(restaurantGroup.Key)" style="cursor: pointer;">
                            <span>
                                <span class="me-2">
                                    <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                </span>
                                <span>
                                    <i class="bi bi-shop me-1"></i>
                                    <span class="fw-bold">@restaurantGroup.Key</span>
                                </span>
                                <span class="badge bg-secondary ms-2">@restaurantGroup.Count() records</span>
                                <span class="badge bg-success ms-1">@restaurantTotalSales.ToString("C")</span>
                                <span class="badge dashboard-badge bg-warning text-dark ms-1" title="Average Rating">
                                    @RenderStars(restaurantAvgRating)
                                    <span class="ms-1">(@restaurantAvgRating.ToString("0.0")/5)</span>
                                </span>
                            </span>
                        </div>

                        @* Expanded: Category Details *@
                        @if (isExpanded)
                        {
                            foreach (var categoryGroup in restaurantGroup.GroupBy(r => r.Category))
                            {
                                var categoryTotalSales = categoryGroup.Sum(r => r.DishPrice * r.QuantitySold);
                                var avgRating = categoryGroup.Any(r => r.Rating > 0)
                                    ? categoryGroup.Where(r => r.Rating > 0).Average(r => r.Rating)
                                    : 0;

                                <div class="mb-4 ms-2">
                                    <h6 class="bg-light p-2 border rounded d-flex flex-wrap align-items-center gap-2">
                                        <span>
                                            <i class="bi bi-tag me-1 text-primary"></i>
                                            <span class="text-primary">@categoryGroup.Key</span>
                                        </span>
                                        <span class="badge bg-secondary">@categoryTotalSales.ToString("C")</span>
                                        <span class="badge dashboard-badge bg-warning text-dark" title="Average Rating">
                                            @RenderStars(avgRating)
                                            <span class="ms-1">(@avgRating.ToString("0.0")/5)</span>
                                        </span>
                                    </h6>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-striped table-sm">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Dish</th>
                                                    <th class="text-end">Qty Sold</th>
                                                    <th class="text-end">Price</th>
                                                    <th class="text-center">Sale Date</th>
                                                    <th class="text-center">Rating</th>
                                                    <th class="text-end">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var record in categoryGroup)
                                                {
                                                    <tr>
                                                        <td>
                                                            <a href="#" class="dish-link" @onclick="() => OnDishClicked(record.DishName)" @onclick:preventDefault>
                                                                @record.DishName
                                                            </a>
                                                        </td>
                                                        <td class="text-end">@record.QuantitySold</td>
                                                        <td class="text-end">@record.DishPrice.ToString("C")</td>
                                                        <td class="text-center">@record.SaleDate.ToString("MMM dd, yyyy")</td>
                                                        <td class="text-center">
                                                            @if (record.Rating > 0)
                                                            {
                                                                <span class="text-warning" title="Rating: @record.Rating/5">
                                                                    @RenderStars(record.Rating)
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">N/A</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">@((record.DishPrice * record.QuantitySold).ToString("C"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            }
        </ChildContent>
    </DetailCard>
</div>

@code {
    private List<SaleRecordDTO>? saleRecords;
    private IReadOnlyList<RestaurantDTO>? restaurants;
    private bool restaurantsLoading = true;
    private bool isloading = true;
    private string? expandedRestaurant;
    private bool _showGuide;

    protected override async Task OnInitializedAsync()
    {
        var restaurantsTask = RestaurantClientService.GetAllAsync();
        var salesTask = SaleRecordService.GetSaleRecordsAsync();

        await Task.WhenAll(restaurantsTask, salesTask);

        var restaurantResult = restaurantsTask.Result;
        restaurants = restaurantResult.IsSuccess ? restaurantResult.Value : [];
        restaurantsLoading = false;

        saleRecords = salesTask.Result;
        isloading = false;
    }

    private void ToggleRestaurant(string restaurantName)
    {
        expandedRestaurant = expandedRestaurant == restaurantName ? null : restaurantName;
    }

    private void ToggleGuide()
    {
        _showGuide = !_showGuide;
    }

    private void OnDishClicked(string dishName)
    {
        NavigationManager.NavigateTo($"/reviews?dishname={Uri.EscapeDataString(dishName)}");
    }

    private int SummarySaleRecords => expandedRestaurant is null
        ? saleRecords?.Count ?? 0
        : saleRecords?.Count(r => r.RestaurantName == expandedRestaurant) ?? 0;

    private int SummaryDishesSold => expandedRestaurant is null
        ? saleRecords?.Sum(r => r.QuantitySold) ?? 0
        : saleRecords?.Where(r => r.RestaurantName == expandedRestaurant).Sum(r => r.QuantitySold) ?? 0;

    private decimal SummaryTotalSales => expandedRestaurant is null
        ? saleRecords?.Sum(r => r.DishPrice * r.QuantitySold) ?? 0
        : saleRecords?.Where(r => r.RestaurantName == expandedRestaurant).Sum(r => r.DishPrice * r.QuantitySold) ?? 0;

    private void NavigateToRestaurant(int id) => NavigationManager.NavigateTo($"/restaurants/{id}");

    private void NavigateToInsights() => NavigationManager.NavigateTo("/insights");

    private static RenderFragment RenderStars(double rating) => builder =>
    {
        int filled = (int)Math.Round(rating);
        for (int i = 0; i < filled; i++)
        {
            builder.OpenElement(0, "span");
            builder.AddContent(1, "★");
            builder.CloseElement();
        }
        for (int i = filled; i < 5; i++)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "text-secondary");
            builder.AddContent(2, "☆");
            builder.CloseElement();
        }
    };
}