@page "/reviews"
@using SmartMenuOptim.Server.Services
@using SmartMenuOptim.Shared.Models
@inject IAIService AIService
@inject IReviewService ReviewService


<h3>📄 Reviews</h3>

@if (reviews == null || !reviews.Any())
{
    <p>No reviews available.</p>
}
else
{
    <p>Total Reviews: @reviews.Count()</p>
    @foreach (var review in reviews)
    {
        <div class="card mt-2 p-2">
            <p><strong>@review.CustomerName:</strong>@review.Comment</p>
            <p><strong>Sentiment Score::</strong> @review.SentimentScore</p>
        </div>
    }
}


@code {
    private List<Review>? reviews;

    protected override async Task OnInitializedAsync()
    {
        reviews = await ReviewService.GetReviewsAsync();
    }
}