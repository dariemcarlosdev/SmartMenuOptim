@page "/reviews"
@using SmartMenuOptim.Server.Services
@using SmartMenuOptim.Shared.Data.Entities
@inject IAIService AIService
@inject IReviewService ReviewService


<h3>📄 Reviews</h3>

@if (reviews == null || !reviews.Any())
{
    <p>No reviews available.</p>
}
else
{
    <p>Total Reviews: @reviews.Count()</p>
    <p>
        <strong>Average All Reviews Sentiment Score:</strong> @(reviews.Average(r => r.SentimentScore).ToString("F1"))
        (@(reviews.Average(r => r.SentimentScore) > 0.75 ? "😊" :
           reviews.Average(r => r.SentimentScore) < 0.4 ? "😠" : "😐"))
    </p>
    @foreach (var review in reviews)
    {  // Display each review with sentiment score and emoji. review.SentimentScore one decimal place

        <div class="card mt-2 p-2">
            <p><strong>@review.CustomerName:</strong>@review.Comment</p>
            <p><strong>Sentiment Score:</strong>
                @review.SentimentScore
                (@(review.SentimentScore > 0.75 ? "😊" :
                   review.SentimentScore < 0.4 ? "😠" : "😐"))
                </p>
        </div>
    }


    
}


@code {
    private List<Review>? reviews;

    protected override async Task OnInitializedAsync()
    {
        reviews = await ReviewService.GetReviewsAsync();
    }
}