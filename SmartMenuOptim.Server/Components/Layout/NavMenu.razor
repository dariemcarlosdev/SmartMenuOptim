@*
    Sidebar toggle button (floating, circular, transparent) for mobile devices.
    This button is only visible when the sidebar is closed (sidebarOpen == false).
    It remains accessible in the middle-left of the viewport, allowing users to open the sidebar.
*@
@if (!sidebarOpen)
{
    <button class="sidebar-fab d-lg-none" type="button" @onclick="ToggleSidebarAsync" aria-label="Open menu">
        <span class="bi bi-list"></span>
    </button>
}

<!-- Sidebar navigation menu -->
<aside class="@(sidebarOpen ? "sidebar sidebar-open" : "sidebar sidebar-closed") d-flex flex-column flex-shrink-0 p-3">
    <a href="/" class="d-flex flex-column align-items-start mb-3 mb-md-0 me-md-auto text-decoration-none">
        <span class="sidebar-logo"><i class="bi bi-speedometer2 me-2"></i>Smart Menu</span>
        <span class="sidebar-meta mt-1">Version 1.0 <span class="text-info ms-1">| In Development</span></span>
    </a>
    <hr class="sidebar-hr" />
    <nav class="nav flex-column gap-1">
        <NavLink class="nav-link d-flex align-items-center" href="" Match="NavLinkMatch.All" activeClass="active" @onclick="CloseSidebarOnMobileAsync">
            <span class="bi bi-house-door-fill me-2"></span> Home
        </NavLink>
        <NavLink class="nav-link d-flex align-items-center" href="Dashboard" activeClass="active" @onclick="CloseSidebarOnMobileAsync">
            <span class="bi bi-speedometer2 me-2"></span> Dashboard
        </NavLink>
        <NavLink class="nav-link d-flex align-items-center" href="restaurants" activeClass="active" @onclick="CloseSidebarOnMobileAsync">
            <span class="bi bi-shop me-2"></span> Restaurants
        </NavLink>
        <NavLink class="nav-link d-flex align-items-center" href="orders" activeClass="active" @onclick="CloseSidebarOnMobileAsync">
            <span class="bi bi-receipt me-2"></span> Orders
        </NavLink>
        <NavLink class="nav-link d-flex align-items-center" href="Insights" activeClass="active" @onclick="CloseSidebarOnMobileAsync">
            <span class="bi bi-lightbulb me-2"></span> Insights
        </NavLink>
        <NavLink class="nav-link d-flex align-items-center" href="Reviews" activeClass="active" @onclick="CloseSidebarOnMobileAsync">
            <span class="bi bi-chat-square-text me-2"></span> Customer Reviews
        </NavLink>
        <NavLink class="nav-link d-flex align-items-center" href="underperforming" activeClass="active" @onclick="CloseSidebarOnMobileAsync">
            <span class="bi bi-graph-down-arrow me-2"></span> Underperforming
        </NavLink>
    </nav>
</aside>
