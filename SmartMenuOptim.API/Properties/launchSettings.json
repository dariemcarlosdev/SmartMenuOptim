{
  "profiles": {
    // HTTP Staging profile
    "http.Staging": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Staging"
      },
      "dotnetRunMessages": true
    },
    // HTTPS Production profile
    "https.Production": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "https://localhost:7140;http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production"
      },
      "dotnetRunMessages": true
    },
    // Development profiles
    "http.Development": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5008"
    },
    // HTTPS Development profile
    "https.Development": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7119;http://localhost:5008"
    },
    // IIS Express profiles. These profiles use ports 23400 for HTTP and 44388 for HTTPS.
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:23400",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    // Docker profiles. This profile use ports 8080 and 8081 for HTTP and HTTPS respectively.
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:8080",
      "environmentVariables": {
        //"ASPNETCORE_HTTPS_PORTS": "8081", // disabling this port for ssl as it is not used in the Dockerfile
        "ASPNETCORE_HTTP_PORTS": "8080",
        "ASPNETCORE_URLS": "http://0.0.0.0:8080"
      },
      "publishAllPorts": true
      //"useSSL": true // disabling this as ssl is not configured in the Dockerfile
    },
    // Production Docker profile. This profile uses ports 8080 and 8443 for HTTP and HTTPS respectively.
    "Container(Dockerfile).Production": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:8080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        //"ASPNETCORE_HTTPS_PORTS": "8443", //disabling this port for ssl as it is not used in the Dockerfile
        "ASPNETCORE_URLS": "http://0.0.0.0:8080"
      },
      "publishAllPorts": true
      //"useSSL": true // disabling this as ssl is not configured in the Dockerfile

    }
  },
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:23393",
      "sslPort": 44388
    }
  }
}